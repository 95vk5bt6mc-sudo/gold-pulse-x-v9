# Market data (required)
TWELVE_DATA_API_KEY=

# Protect /api/scan and /api/notify (required, use a long random value)
GOLD_PULSE_API_SECRET=

# LINE Messaging API (required for alerts)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Recommended: your Uxxxxxxxx LINE user ID for one-to-one push.
# Leave blank to use broadcast to every friend of the Official Account.
LINE_TARGET_ID=
LINE_ALERTS_ENABLED=true
# R2.1: reserve messages for STRONG signals near monthly quota exhaustion.
LINE_MONTHLY_RESERVE_MESSAGES=30

# v10.2 adaptive quality profile
ADAPTIVE_SIGNAL_MODE=true
TARGET_SIGNAL_INTERVAL_MINUTES=30
DAILY_ALERT_SAFETY_CAP=32

# Required for reliable adaptive timing on Vercel.
# Add Upstash Redis from Vercel Marketplace, then redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADAPTIVE_STATE_REQUIRED=false

# Optional tuning. Defaults shown below.
# TECHNICAL_MINIMUM_GAP_MINUTES=2
# ADAPTIVE_COLD_START_QUALITY=78
# ADAPTIVE_ELITE_QUALITY=92
# ADAPTIVE_EARLY_QUALITY=86
# ADAPTIVE_TARGET_QUALITY=80
# ADAPTIVE_LATE_QUALITY=76
# ADAPTIVE_QUALITY_FLOOR=72
# ADAPTIVE_REVERSAL_PENALTY=4
# ADAPTIVE_SAME_DIRECTION_IMPROVEMENT=3
# ADAPTIVE_CANDIDATE_EXPIRY_MINUTES=20

# Custom base gates are used only when ADAPTIVE_SIGNAL_MODE=false
ALERT_MIN_PROBABILITY=62
ALERT_MIN_SCORE=58
