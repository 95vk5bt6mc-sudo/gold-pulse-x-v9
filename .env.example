# Market data (required)
TWELVE_DATA_API_KEY=

# Protect /api/scan and /api/notify (required, use a long random value)
GOLD_PULSE_API_SECRET=

# LINE Messaging API (required for alerts)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Recommended: your Uxxxxxxxx LINE user ID for one-to-one push.
# Leave blank to use broadcast to every friend of the Official Account.
LINE_TARGET_ID=

# Signal profile (v10 defaults to Pulse mode; no Vercel change is required after upgrade)
ACTIVE_SIGNAL_MODE=true
TARGET_ALERTS_PER_DAY=20

# Custom gates are used only when ACTIVE_SIGNAL_MODE=false
ALERT_MIN_PROBABILITY=60
ALERT_MIN_SCORE=54
ALERT_COOLDOWN_MINUTES=20
LINE_ALERTS_ENABLED=true

# Optional only when ACTIVE_SIGNAL_MODE=false
# PULSE_COOLDOWN_MINUTES=30
